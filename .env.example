GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional: iMessage via Photon Spectrum (app.photon.codes → Configure → Copy)
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
# Optional: PHONE_<PERSONID>=+1XXXXXXXXXX (E.164) links a phone to a seed person id (ethan, jerry, jack, tom, thomas).
# The number must be on the Photon Users page and must have texted the line once. Keep comments on their own line.
PHONE_ETHAN=
# Optional settings (defaults shown; shell variables win over this file):
# PORT=3000
# DATA_DIR=data
# Pickup reminder n seconds after both agree, instead of 30 minutes before the time:
# DEMO_REMINDER_SECONDS=1
# Ask thread questions as iMessage polls instead of the 👍/👎 line (off by default):
# LOOP_POLLS=1
# Canned drafts, no Gemini calls, iMessage off (tests and offline demos):
# GEMINI_MOCK=1
